{
  "name": "scruple-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "gen:leaf-registry": "node lib/leaf/generate.mjs",
    "test:v2": "SCRUPLE_DB_PATH=$(mktemp -d)/v2-test.db node --import tsx --test test/v2/*.test.ts",
    "test": "npm run test:v2 && npm run test:integration",
    "test:sdk": "cd packages/scruple-host-sdk && python3 -m pytest -q",
    "test:integration": "node --import tsx --test test/integration/*.test.ts"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.4.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.3.0",
    "clsx": "^2.1.1",
    "nanoid": "^5.0.7",
    "next": "14.2.15",
    "next-auth": "5.0.0-beta.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.1.1",
    "ws": "^8.21.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.15",
    "js-yaml": "^4.1.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
